# Root .gitignore for StudyWise

# Dependencies & Build artifacts
**/node_modules/
**/dist/
**/build/
**/target/
**/.mvn/wrapper/maven-wrapper.jar

# IDE & Editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db

# Environment & Logs
*.log
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS metadata
.directory
